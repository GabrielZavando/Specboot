{
  "name": "@gabrielzavando/specboot",
  "version": "0.11.0",
  "description": "SDD development framework for OpenCode + OpenSpec: agents, commands, skills, and validation tools that enforce the Spec-Driven Development flow.",
  "license": "MIT",
  "bin": {
    "specboot": "specboot.sh"
  },
  "scripts": {
    "check": "bash check-refs.sh",
    "validate": "bash validate-specboot.sh",
    "ci": "bash specboot.sh --ci"
  },
  "files": [
    ".opencode/commands",
    ".opencode/agents",
    "ai-specs",
    "check-refs.sh",
    "release-bump.sh",
    "specboot.sh",
    "validate-specboot.sh",
    "templates/ci",
    "templates/github",
    "docs/base-standards.md",
    "docs/framework-contract.md",
    "docs/docs-standard.md",
    "docs/specboot-json-standard.md",
    "docs/versioning-standard.md",
    "docs/openspec-tasks-mandatory-steps.md",
    "docs/tdd-failure-protocol.md",
    "opencode.json",
    "AGENTS.md",
    "Makefile",
    "LICENSE",
    "README.md",
    "scripts/validate-agent-permissions.mjs",
    "scripts/validate-command-contracts.mjs",
    "scripts/read-json-field.mjs",
    "docs/agent-permission-contracts.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GabrielZavando/Specboot.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "sdd",
    "openspec",
    "opencode",
    "framework",
    "spec-driven-development",
    "agents"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "js-yaml": "^5.4.2"
  }
}
