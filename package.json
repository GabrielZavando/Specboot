{
  "name": "@gabrielzavando/specboot",
  "version": "0.2.0",
  "description": "SDD development framework for OpenCode + OpenSpec: agents, commands, skills, and validation tools that enforce the Spec-Driven Development flow.",
  "license": "MIT",
  "bin": { "specboot": "specboot.sh" },
  "scripts": {
    "check": "bash check-refs.sh",
    "validate": "bash validate-specboot.sh",
    "ci": "bash specboot.sh --ci"
  },
  "files": [
    ".opencode/commands",
    ".opencode/agents",
    "ai-specs",
    "check-refs.sh",
    "specboot.sh",
    "validate-specboot.sh",
    "templates/ci",
    "docs/base-standards.md",
    "docs/framework-contract.md",
    "docs/docs-standard.md",
    "docs/specboot-json-standard.md",
    "docs/versioning-standard.md",
    "opencode.json",
    "AGENTS.md",
    "Makefile",
    ".github/workflows",
    "LICENSE",
    "README.md"
  ],
  "repository": { "type": "git", "url": "git+https://github.com/GabrielZavando/Specboot.git" },
  "publishConfig": { "registry": "https://npm.pkg.github.com" },
  "keywords": ["sdd", "openspec", "opencode", "framework", "spec-driven-development", "agents"],
  "engines": { "node": ">=18" }
}
